<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen "Now Playing" view. Background gradient follows the album art colour. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/full_player_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0"
    android:background="@color/bg_base"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="24dp"
    android:visibility="invisible">

    <!-- Top bar -->
    <ImageView
        android:id="@+id/btn_collapse"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="-8dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close player"
        android:padding="6dp"
        android:src="@drawable/ic_chevron_down"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <LinearLayout
        android:id="@+id/playing_from_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/btn_collapse"
        app:layout_constraintEnd_toStartOf="@id/btn_options"
        app:layout_constraintStart_toEndOf="@id/btn_collapse"
        app:layout_constraintTop_toTopOf="@id/btn_collapse">

        <TextView
            android:id="@+id/tv_playing_from_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="PLAYING FROM"
            android:textColor="@color/text_primary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_playing_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Jarvis Music"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btn_options"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="-8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="More options"
        android:padding="8dp"
        android:src="@drawable/ic_more_options"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_collapse"
        app:tint="@color/white" />

    <!-- Album art: swipe left/right to change songs -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/full_album_art"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="Album art"
        android:elevation="12dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@id/full_title"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_collapse"
        app:shapeAppearanceOverlay="@style/RoundedSquare" />

    <!-- Title / artist / like -->
    <TextView
        android:id="@+id/full_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:text="Song Title"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/full_artist"
        app:layout_constraintEnd_toStartOf="@id/btn_like"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/full_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        android:background="?attr/selectableItemBackground"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="Artist Name"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/player_seekbar"
        app:layout_constraintEnd_toStartOf="@id/btn_like"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/btn_like"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="-10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Like"
        android:padding="10dp"
        android:src="@drawable/ic_heart_outline"
        app:layout_constraintBottom_toBottomOf="@id/full_artist"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/full_title"
        app:tint="@color/white" />

    <!-- Seek bar + times -->
    <SeekBar
        android:id="@+id/player_seekbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"
        android:maxHeight="4dp"
        android:minHeight="4dp"
        android:paddingVertical="10dp"
        android:progressDrawable="@drawable/seekbar_progress"
        android:splitTrack="false"
        android:thumb="@drawable/seekbar_thumb"
        app:layout_constraintBottom_toTopOf="@id/tv_elapsed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_elapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="0:00"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@id/btn_full_play_pause"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-0:00"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_elapsed"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Transport controls -->
    <ImageView
        android:id="@+id/btn_shuffle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="-10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Shuffle"
        android:padding="10dp"
        android:src="@drawable/ic_shuffle"
        app:layout_constraintBottom_toBottomOf="@id/btn_full_play_pause"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_full_play_pause"
        app:tint="@color/white" />

    <ImageView
        android:id="@+id/btn_prev"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Previous"
        android:padding="8dp"
        android:src="@drawable/ic_prev"
        app:layout_constraintBottom_toBottomOf="@id/btn_full_play_pause"
        app:layout_constraintEnd_toStartOf="@id/btn_full_play_pause"
        app:layout_constraintStart_toEndOf="@id/btn_shuffle"
        app:layout_constraintTop_toTopOf="@id/btn_full_play_pause"
        app:tint="@color/white" />

    <ImageButton
        android:id="@+id/btn_full_play_pause"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_circle_white"
        android:contentDescription="Play or pause"
        android:padding="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play"
        app:layout_constraintBottom_toTopOf="@id/bottom_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/black" />

    <ImageView
        android:id="@+id/btn_next"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Next"
        android:padding="8dp"
        android:src="@drawable/ic_next"
        app:layout_constraintBottom_toBottomOf="@id/btn_full_play_pause"
        app:layout_constraintEnd_toStartOf="@id/btn_repeat"
        app:layout_constraintStart_toEndOf="@id/btn_full_play_pause"
        app:layout_constraintTop_toTopOf="@id/btn_full_play_pause"
        app:tint="@color/white" />

    <ImageView
        android:id="@+id/btn_repeat"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="-10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Repeat"
        android:padding="10dp"
        android:src="@drawable/ic_repeat_all"
        app:layout_constraintBottom_toBottomOf="@id/btn_full_play_pause"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_full_play_pause"
        app:tint="@color/white" />

    <!-- Bottom row: download · share · queue -->
    <LinearLayout
        android:id="@+id/bottom_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/btn_download"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="-10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Download"
            android:padding="10dp"
            android:src="@drawable/ic_download_circle"
            app:tint="@color/white" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btn_share"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share"
            android:padding="11dp"
            android:src="@drawable/ic_share"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btn_up_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="-10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Queue"
            android:padding="10dp"
            android:src="@drawable/ic_queue"
            app:tint="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
